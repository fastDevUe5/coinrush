# OS / 编辑器杂项
Thumbs.db
Desktop.ini
.DS_Store
*.log

# DSH 本地 bundle 的依赖（源文件仍然提交）
dsh-bundles/**/node_modules/
dsh-bundles/**/.pnpm-store/

# 本地 token / 临时文件
*.tmp
*.bak

# git-lfs 安装时自动写入的钩子（重新执行 git lfs install --local 会重建）
.githooks/post-checkout
.githooks/post-commit
.githooks/post-merge
.githooks/pre-push

